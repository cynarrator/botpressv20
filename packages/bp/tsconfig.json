{
  "compilerOptions": {
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "module": "commonjs",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "target": "es2022",
    "lib": ["es2022"],
    "noImplicitAny": false,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useUnknownInCatchVariables": false,
    "baseUrl": "./src",
    "outDir": "dist",
    "typeRoots": ["./src/typings", "../../node_modules/@types", "./src/common"],
    "types": ["reflect-metadata", "jest", "node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "src/**/*.test.*", "node_modules", "src/admin/ui/**/*"]
}
