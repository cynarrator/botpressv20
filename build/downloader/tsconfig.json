{
  "compilerOptions": {
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "module": "commonjs",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "target": "es2021",
    "lib": ["es2021"],
    "noImplicitAny": false,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "baseUrl": "./src",
    "outDir": "./dist",
    "types": ["node"],
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true
  }
}
